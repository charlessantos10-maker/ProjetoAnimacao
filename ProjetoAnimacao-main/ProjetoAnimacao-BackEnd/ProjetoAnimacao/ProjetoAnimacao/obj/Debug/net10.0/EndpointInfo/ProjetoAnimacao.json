  "components": {
    "schemas": {
      "AuthResponse": {
        "required": [
          "token",
          "expiresAtUtc",
          "user"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        }
      },
      "CreateProjectRequest": {
        "required": [
          "title",
          "description",
          "type"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "type": "string"
          }
        }
      },
      "CreateProposalRequest": {
        "required": [
          "companyName",
          "serviceDescription",
          "offeredAmount",
          "companyWebsite",
          "details"
        ],
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string"
          },
          "serviceDescription": {
            "type": "string"
          },
          "offeredAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "companyWebsite": {
            "type": [
              "null",
              "string"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      },
      "CreatePublicationRequest": {
        "required": [
          "projectId",
          "platform",
          "description",
          "externalUrl"
        ],
        "type": "object",
        "properties": {
          "projectId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "platform": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "externalUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateSocialAccountRequest": {
        "required": [
          "platform",
          "profileUrl"
        ],
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "profileUrl": {
            "type": "string"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "name",
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SaveEvaluationRequest": {
        "required": [
          "reputationNotes",
          "targetAudienceNotes",
          "compatibilityNotes",
          "rightsAndPaymentNotes",
          "decision"
        ],
        "type": "object",
        "properties": {
          "reputationNotes": {
            "type": [
              "null",
              "string"
            ]
          },
          "targetAudienceNotes": {
            "type": [
              "null",
              "string"
            ]
          },
          "compatibilityNotes": {
            "type": [
              "null",
              "string"
            ]
          },
          "rightsAndPaymentNotes": {
            "type": [
              "null",
              "string"
            ]
          },
          "decision": {
            "type": "string"
          }
        }
      },
      "UpdateProjectRequest": {
        "required": [
          "title",
          "description",
          "type"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "type": "string"
          }
        }
      },
      "UserResponse": {
        "required": [
          "id",
          "name",
          "email"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "temperatureF": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
